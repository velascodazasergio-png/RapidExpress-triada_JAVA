
digraph ERD {
    rankdir=LR;
    splines=spline;
    nodesep=0.6;
    ranksep=1.5;
    bgcolor="white";
    labelloc="t";
    label=<<FONT POINT-SIZE="22"><B>RapidExpress · Modelo Entidad-Relación</B></FONT><BR/>
           <FONT POINT-SIZE="12" COLOR="#5A6472">Sistema de Gestión de Flotas y Rutas</FONT><BR/> >;
    fontname="Helvetica";
    node [shape=plaintext, fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=10, color="#1F3A5F", arrowhead=crow,
          arrowtail=none, dir=both, labeldistance=1.8, labelfontsize=9,
          labelfontcolor="#5A6472"];

        conductores [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1F3A5F" COLSPAN="2" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>conductores</B></FONT></TD></TR><TR><TD BGCOLOR="#EAF0F7" ALIGN="LEFT"><B>PK</B></TD><TD BGCOLOR="#EAF0F7" ALIGN="LEFT"><B>id_conductor</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">UK</FONT></TD><TD ALIGN="LEFT">identificacion</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">nombre_completo</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">tipo_licencia</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">telefono</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">estado</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">fecha_registro</TD></TR></TABLE>>];
    vehiculos [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1F3A5F" COLSPAN="2" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>vehiculos</B></FONT></TD></TR><TR><TD BGCOLOR="#EAF0F7" ALIGN="LEFT"><B>PK</B></TD><TD BGCOLOR="#EAF0F7" ALIGN="LEFT"><B>id_vehiculo</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">UK</FONT></TD><TD ALIGN="LEFT">placa</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">marca</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">modelo</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">anio</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">capacidad_kg</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">estado</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">FK UK</FONT></TD><TD ALIGN="LEFT">id_conductor</TD></TR></TABLE>>];
    mantenimientos [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1F3A5F" COLSPAN="2" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>mantenimientos</B></FONT></TD></TR><TR><TD BGCOLOR="#EAF0F7" ALIGN="LEFT"><B>PK</B></TD><TD BGCOLOR="#EAF0F7" ALIGN="LEFT"><B>id_mantenimiento</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">FK</FONT></TD><TD ALIGN="LEFT">id_vehiculo</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">tipo</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">descripcion</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">fecha_programada</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">fecha_realizacion</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">costo</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">taller</TD></TR></TABLE>>];
    personas [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1F3A5F" COLSPAN="2" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>personas</B></FONT></TD></TR><TR><TD BGCOLOR="#EAF0F7" ALIGN="LEFT"><B>PK</B></TD><TD BGCOLOR="#EAF0F7" ALIGN="LEFT"><B>id_persona</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">UK</FONT></TD><TD ALIGN="LEFT">identificacion</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">nombre_completo</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">telefono</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">correo</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">ciudad</TD></TR></TABLE>>];
    paquetes [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1F3A5F" COLSPAN="2" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>paquetes</B></FONT></TD></TR><TR><TD BGCOLOR="#EAF0F7" ALIGN="LEFT"><B>PK</B></TD><TD BGCOLOR="#EAF0F7" ALIGN="LEFT"><B>id_paquete</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">UK</FONT></TD><TD ALIGN="LEFT">codigo_seguimiento</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">descripcion</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">peso_kg</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">alto_cm / ancho_cm / largo_cm</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">direccion_origen</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">direccion_destino</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">FK</FONT></TD><TD ALIGN="LEFT">id_remitente</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">FK</FONT></TD><TD ALIGN="LEFT">id_destinatario</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">estado</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">fecha_registro</TD></TR></TABLE>>];
    rutas [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1F3A5F" COLSPAN="2" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>rutas</B></FONT></TD></TR><TR><TD BGCOLOR="#EAF0F7" ALIGN="LEFT"><B>PK</B></TD><TD BGCOLOR="#EAF0F7" ALIGN="LEFT"><B>id_ruta</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">UK</FONT></TD><TD ALIGN="LEFT">codigo_ruta</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">fecha_programada</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">FK</FONT></TD><TD ALIGN="LEFT">id_vehiculo</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">FK</FONT></TD><TD ALIGN="LEFT">id_conductor</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">estado</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">fecha_inicio</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">fecha_fin</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">observaciones</TD></TR></TABLE>>];
    ruta_paquetes [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1F3A5F" COLSPAN="2" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>ruta_paquetes</B></FONT></TD></TR><TR><TD BGCOLOR="#EAF0F7" ALIGN="LEFT"><B>PK</B></TD><TD BGCOLOR="#EAF0F7" ALIGN="LEFT"><B>id_ruta + id_paquete</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">FK</FONT></TD><TD ALIGN="LEFT">id_ruta</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">FK</FONT></TD><TD ALIGN="LEFT">id_paquete</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">orden_entrega</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">fecha_entrega</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">resultado</TD></TR></TABLE>>];
    auditoria [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1F5F45" COLSPAN="2" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>auditoria</B></FONT></TD></TR><TR><TD BGCOLOR="#E6F2EC" ALIGN="LEFT"><B>PK</B></TD><TD BGCOLOR="#E6F2EC" ALIGN="LEFT"><B>id_auditoria</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">fecha_hora</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">operacion</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">entidad</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">id_entidad</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">usuario</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">estado_anterior</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">estado_nuevo</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#5A6472">&#160;</FONT></TD><TD ALIGN="LEFT">detalle</TD></TR></TABLE>>];

        conductores -> vehiculos      [taillabel="1", headlabel="0..1", label="conduce"];
    vehiculos   -> mantenimientos [taillabel="1", headlabel="0..N", label="recibe"];
    vehiculos   -> rutas          [taillabel="1", headlabel="0..N", label="cubre"];
    conductores -> rutas          [taillabel="1", headlabel="0..N", label="opera"];
    personas    -> paquetes       [taillabel="1", headlabel="0..N", label="envía / recibe"];
    rutas       -> ruta_paquetes  [taillabel="1", headlabel="0..N", label="transporta"];
    paquetes    -> ruta_paquetes  [taillabel="1", headlabel="0..N", label="se asigna"];
    rutas       -> auditoria      [style=dashed, color="#8A94A6", constraint=false, label="registra", fontcolor="#8A94A6"];
    paquetes    -> auditoria      [style=dashed, color="#8A94A6", constraint=false, label="registra", fontcolor="#8A94A6"];
}
